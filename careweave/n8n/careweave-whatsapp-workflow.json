    {
      "parameters": {
        "jsCode": "const to = $('Parse Inbound Message').first().json.to;\nconst r = $json;\nlet text;\nif (!r.found) text = 'We could not find a CareWeave record for this number. Please check with the front desk.';\nelse if (!r.active) text = `Hello ${r.patient.name}, you are not in today's queue.`;\nelse if (r.status === 'In Consultation') text = `Hello ${r.patient.name}, ${r.doctor} is seeing you now (${r.room}).`;\nelse text = `Hello ${r.patient.name}, your token is *${r.token}* with ${r.doctor} (${r.room}).\\n${r.aheadCount} patient(s) ahead. Estimated wait: about ${r.estimatedWaitMinutes} min.`;\nreturn [{ json: { to, text } }];"
      },
      "id": "format-queue-reply",
      "name": "Format Queue Reply",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1240,
        440
      ]
    },
    {
      "parameters": {
        "jsCode": "const to = $('Parse Inbound Message').first().json.to;\nconst r = $json;\nlet text;\nif (r.verificationRequired) text = \"To protect your health records, add your UHID after the word, for example: REPORT CW-12345. It is on your token slip and patient card.\";\nelse if (!r.found) text = 'We could not find a CareWeave record for this number. Please check with the front desk.';\nelse if (!r.available) text = `Hello ${r.patient.name}, you have no verified lab report yet.`;\nelse {\n  const rep = r.report;\n  const rows = rep.results.slice(0, 12).map(x => `${x.flag === 'critical' ? '🔴' : x.flag === 'abnormal' ? '🟠' : '▫️'} ${x.parameter}: ${x.value} ${x.unit}${x.flag !== 'normal' ? ' (' + x.flag.toUpperCase() + ')' : ''}`);\n  text = `🧪 ${rep.testName} - verified by ${rep.verifiedBy || 'the laboratory'}\\n${rows.join('\\n')}\\nCritical flags: ${rep.criticalCount}. Please discuss these results with your doctor.`;\n}\nreturn [{ json: { to, text } }];"
      },
      "id": "format-report-reply",
      "name": "Format Report Reply",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1240,
        580
      ]
    },
    {
      "parameters": {
        "jsCode": "const to = $('Parse Inbound Message').first().json.to;\nconst r = $json;\nlet text;\nif (r.verificationRequired) text = \"To protect your health records, add your UHID after the word, for example: REPORT CW-12345. It is on your token slip and patient card.\";\nelse if (!r.found) text = 'We could not find a CareWeave record for this number. Please check with the front desk.';\nelse if (!r.medications.length) text = `Hello ${r.patient.name}, you have no active prescriptions.`;\nelse {\n  const part = (label, slot) => {\n    const rows = r.medications.filter(m => m.schedule && m.schedule[slot]).map(m => `  • ${m.medicine} - ${m.schedule[slot]}${m.food ? ' (' + m.food + ')' : ''}`);\n    return rows.length ? `*${label}*\\n${rows.join('\\n')}` : '';\n  };\n  const other = r.medications.filter(m => !m.schedule).map(m => `  • ${m.medicine} - ${m.dosage}, ${m.frequency}`);\n  text = ['💊 Medicines for ' + r.patient.name, part('Morning','morning'), part('Afternoon','afternoon'), part('Night','night'), other.length ? '*As directed*\\n' + other.join('\\n') : ''].filter(Boolean).join('\\n');\n}\nreturn [{ json: { to, text } }];"
      },
      "id": "format-meds-reply",
      "name": "Format Meds Reply",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1240,
        720
      ]
    },
    {
      "parameters": {
        "jsCode": "const to = $json.to;\nconst text = 'CareWeave on WhatsApp. Reply with:\\n*QUEUE* - your token and wait time\\n*REPORT <your UHID>* - your latest verified lab report\\n*MEDS <your UHID>* - your medicine timings\\nYour UHID is on your token slip and patient card.';\nreturn [{ json: { to, text } }];"
      },
