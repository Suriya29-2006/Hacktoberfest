    {
      "parameters": {
        "jsCode": "const e = $json.body;\nconst raw = e.phone;\nconst digits = String(raw || '').replace(/\\D/g, '');\nconst cc = ($env.DEFAULT_COUNTRY_CODE || '91').replace(/\\D/g, '');\nconst to = digits.length === 10 ? cc + digits : digits; // WhatsApp wants country code + number, no plus sign\nconst live = ($env.CAREWEAVE_PUBLIC_URL || $env.CAREWEAVE_API_URL || '') + '/receptionist';\nconst text = `Welcome to CareWeave, ${e.name}! 🏥\\nToken: *${e.token}*\\nDoctor: ${e.doctor} (${e.room})\\nQueue position: ${e.queuePosition}\\nReply QUEUE any time for your live wait.\\nLive queue: ${live}`;\nreturn [{ json: { to, text } }];"
      },
      "id": "format-check-in",
      "name": "Format Check-in",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        520,
        60
      ]
    },
    {
      "parameters": {
        "jsCode": "const e = $json.body;\nconst raw = e.phone;\nconst digits = String(raw || '').replace(/\\D/g, '');\nconst cc = ($env.DEFAULT_COUNTRY_CODE || '91').replace(/\\D/g, '');\nconst to = digits.length === 10 ? cc + digits : digits; // WhatsApp wants country code + number, no plus sign\nconst status = e.criticalCount > 0 ? 'Needs attention' : (e.abnormalCount > 0 ? 'Some values outside range' : 'Normal');\nconst text = `🧪 CareWeave Lab Alert: Hello ${e.name}, your ${e.testName} results have been verified by ${e.pathologist || 'the laboratory'}. Status: ${status} / Critical flags: ${e.criticalCount}.\\nReply REPORT ${e.patientId || '<your UHID>'} to see the values.`;\nreturn [{ json: { to, text } }];"
      },
      "id": "format-lab-report",
      "name": "Format Lab Report",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        520,
        200
      ]
    },
    {
      "parameters": {
        "jsCode": "const e = $json.body;\nconst raw = e.phone;\nconst digits = String(raw || '').replace(/\\D/g, '');\nconst cc = ($env.DEFAULT_COUNTRY_CODE || '91').replace(/\\D/g, '');\nconst to = digits.length === 10 ? cc + digits : digits; // WhatsApp wants country code + number, no plus sign\nconst lines = (e.medicines || []).map(m => `• ${m.name} - ${m.dosage}, ${m.frequency}${m.foodInstruction ? ' (' + m.foodInstruction + ')' : ''}`);\nconst text = `💊 Hello ${e.name}, ${e.doctor || 'your doctor'} prescribed:\\n${lines.join('\\n')}\\nReply MEDS ${e.patientId || '<your UHID>'} for your daily timings.`;\nreturn [{ json: { to, text } }];"
      },
      "id": "format-prescription",
      "name": "Format Prescription",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        520,
        340
      ]
    },
    {
      "parameters": {
        "jsCode": "const e = $json.body;\nconst raw = e.from;\nconst digits = String(raw || '').replace(/\\D/g, '');\nconst cc = ($env.DEFAULT_COUNTRY_CODE || '91').replace(/\\D/g, '');\nconst to = digits.length === 10 ? cc + digits : digits; // WhatsApp wants country code + number, no plus sign\nconst parts = String(e.body || '').trim().split(/\\s+/);\nconst keyword = (parts[0] || '').toUpperCase();\nconst uhid = parts[1] || ''; // reports and medicines also need the patient's UHID\nreturn [{ json: { to, phone: to, keyword, uhid } }];"
      },
      "id": "parse-inbound-message",
      "name": "Parse Inbound Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        520,
        520
      ]
    },
